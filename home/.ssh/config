# Shared across machines (rsync'd from dotfiles). Machine-specific hosts go in
# ~/.ssh/config.local, which is not tracked. Missing Include targets are ignored.
Include ~/.ssh/config.local
Include ~/.orbstack/ssh/config
Include ~/.config/colima/ssh_config

# 1Password writes Host blocks here for bookmarked hosts
# (Settings > Developer > SSH Agent > Generate SSH config files with bookmarked hosts).
Include ~/.ssh/1Password/config

# One key per host. The agent holds 7 keys and sshd allows 6 tries, so a late
# key never gets its turn. Public halves live in ~/.ssh/keys, exported from the
# agent; private keys stay in 1Password.
Host valkyrie valkyrie.tail794df.ts.net
	IdentityFile ~/.ssh/keys/valkyrie.pub
	IdentitiesOnly yes

# Forgejo's sshd, not the host's. Plain ssh/git to this name goes to port 2222.
Host forgejo.thayn.gay
	Port 2222
	IdentityFile ~/.ssh/keys/forgejo.pub
	IdentitiesOnly yes

# 1Password SSH agent, wherever it is on this OS.
Match exec "test -S \"$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock\""
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
Match exec "test -S $HOME/.1password/agent.sock"
	IdentityAgent ~/.1password/agent.sock
